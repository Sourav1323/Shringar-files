# ==============================================================================
# Shringar Platform — DevOps Environment Configuration Template
# Copy this file to `.env` and fill in the values for your environment.
# ==============================================================================

# ── General Server / Domain Settings ──
DOMAIN_NAME=shringar.in
APP_ENV=production
DOCKER_REGISTRY=ghcr.io/your-github-username
IMAGE_TAG=latest

# ── Database (MySQL) ──
DB_NAME=shringar_db
DB_USER=shringar_user
DB_PASSWORD=ChangeThisToAStrongDbPassword123!
DB_ROOT_PASSWORD=ChangeThisRootPasswordSecurely456!

# ── Spring Boot & Security ──
# Generate with: openssl rand -base64 48
JWT_SECRET=ShringarMehendiArtSecretKey2024VeryLongSecureKeyForJWTSigningAlgorithm
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Mail Service (Gmail SMTP / SendGrid / AWS SES) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=shringar.admin@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
ADMIN_NOTIFICATION_EMAILS=shringar.admin@gmail.com

# ── Payment Gateway (Optional / Secondary to UPI) ──
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# ── SMS Providers (Optional) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=

# ── AI Feature (Gemini API - For future activation) ──
GEMINI_API_KEY=
